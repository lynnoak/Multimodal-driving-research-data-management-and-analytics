# Public release allowlist. Everything else remains local and untracked.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/README.md
!/CHANGELOG.md
!/Dockerfile
!/compose.demo.yaml
!/pytest.ini
!/requirements-api.txt
!/requirements-dashboard.txt
!/requirements-dev.txt
!/app/
!/dashboard/
!/feature_store/
!/kong/
!/scripts/
!/tests/
!/docs/
!/.streamlit/

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.env*
**/secrets.toml
**/*.log
**/*.tmp
**/*.csv
**/*.json
**/*.xlsx
**/*.xls
**/*.zip
**/*.exe
**/*.bak
**/*.dump
**/node_modules/
**/.venv*/
!/.env.example
# Private ingestion adapters and research-specific tests are not needed by Demo.
/feature_store/import_features.py
/feature_store/pipeline.py
/tests/test_feature_store.py
/tests/test_research_regression.py
/docs/private-live.local.md
